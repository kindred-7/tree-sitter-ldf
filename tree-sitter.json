{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ldf",
      "camelcase": "Ldf",
      "title": "LIN Description File",
      "scope": "source.ldf",
      "file-types": [
        "ldf"
      ],
      "injection-regex": "^ldf$",
      "class-name": "TreeSitterLdf"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "LIN Description File (LDF) grammar for tree-sitter",
    "authors": [
      {
        "name": "kindred-7"
      }
    ],
    "links": {
      "repository": "https://github.com/kindred-7/tree-sitter-ldf"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
